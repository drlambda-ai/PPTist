{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/deck.py": {
      "maxDuration": 800,
      "includeFiles": "deck/**",
      "excludeFiles": "{node_modules,dist,src,public,doc,.deck-data}/**"
    },
    "api/tools/*.ts": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
